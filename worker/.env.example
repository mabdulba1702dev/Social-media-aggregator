# Env vars for the standalone worker (Railway/Fly.io), NOT the Vercel app.
# See docs/setup-guide.md §6 for how to obtain each.

SUPABASE_URL=
# Service role — this worker acts on behalf of any board's connected
# source, not a single logged-in user, so it needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

DISCORD_BOT_TOKEN=

# No token for WhatsApp — Baileys authenticates by pairing a dedicated
# phone number's WhatsApp app (QR/pairing code) on first run, then
# persists the resulting session. Point this at wherever that session
# gets stored (recommend Supabase Storage so a worker restart doesn't
# force re-pairing).
WHATSAPP_SESSION_STORAGE_PATH=
